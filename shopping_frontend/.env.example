# Development environment variables for CRA dev server.
# Do NOT commit real secrets. Copy to .env for local usage if needed.

# Networking
HOST=0.0.0.0
PORT=3000
HTTPS=false
BROWSER=none

# Webpack Dev Server socket port (helps in proxied environments)
WDS_SOCKET_PORT=3000

# CRA host check control (development-only; unsafe for production)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Frontend runtime configuration
REACT_APP_API_BASE_URL=

# Optional: if using reverse proxy previews, you may set a public URL/homepage
# PUBLIC_URL=
# homepage=
