# Example environment variables for Shopping Frontend
# Copy this file to ".env" and adjust values if needed.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Overrides the backend API base URL used by the frontend.
# If not set, the app defaults to:
#   http://localhost:3001
# Example:
# REACT_APP_API_BASE_URL=http://localhost:4000
REACT_APP_API_BASE_URL=
